generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // مدير النظام
  EXECUTIVE // الإدارة العليا
  HR // الموارد البشرية
  FINANCE // المالية
  IT // تقنية المعلومات
  EMPLOYEE // موظف
}

enum ContractType {
  PERMANENT // غير محدد المدة
  FIXED // محدد المدة
  SEASONAL // موسمي (الحج)
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum DocumentType {
  NATIONAL_ID
  IQAMA
  PASSPORT
  CONTRACT
  WORK_PERMIT
  DRIVING_LICENSE
  CERTIFICATE
  MEDICAL
  OTHER
}

enum MeetingMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED // اعتُمد محضره
  CANCELLED
}

enum InviteResponse {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  HARDWARE // أجهزة
  SOFTWARE // برامج
  NETWORK // شبكة وإنترنت
  EMAIL // بريد إلكتروني
  ACCESS // حسابات وصلاحيات
  PRINTER // طابعات
  PHONE // اتصالات
  OTHER
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  WAITING_USER // بانتظار رد الموظف
  RESOLVED
  CLOSED
}

enum CircularCategory {
  ADMINISTRATIVE
  HR
  FINANCE
  OPERATIONS
  IT
  GENERAL
}

enum CircularAudience {
  ALL
  DEPARTMENTS
  PEOPLE
}

enum RequestType {
  LEAVE // إجازة
  LETTER // خطاب
  PLEDGE // تعهد أو استلام عهدة (ترسله الموارد البشرية أو التقنية للموظف)
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApproverKind {
  MANAGER // المدير المباشر
  HR // أي موظف بصلاحية الموارد البشرية
  CEO // الرئيس التنفيذي (من إعدادات التعميد)
  EMPLOYEE // الموظف نفسه (إقرار التعهد)
}

enum StepStatus {
  WAITING // لم يصل دوره بعد
  PENDING // بانتظار الإجراء
  APPROVED
  REJECTED
  SKIPPED // تخطي تلقائي (لا يوجد مدير، أو المعتمد هو مقدم الطلب)
}

model Department {
  id        String               @id @default(cuid())
  name      String               @unique
  sortOrder Int                  @default(0)
  parentId  String?
  parent    Department?          @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[]         @relation("DepartmentTree")
  headId    String?              @unique
  head      User?                @relation("DepartmentHead", fields: [headId], references: [id])
  members   User[]               @relation("DepartmentMembers")
  circulars CircularDepartment[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model User {
  id                 String              @id @default(cuid())
  employeeNo         String              @unique
  name               String
  email              String              @unique
  passwordHash       String
  // يُلزم المستخدم بتغيير كلمة المرور عند الدخول (حساب جديد أو كلمة مرور أعاد المدير تعيينها)
  mustChangePassword Boolean             @default(true)
  role               Role                @default(EMPLOYEE)
  jobTitle           String?
  phone              String?
  // رقم الهوية الوطنية أو الإقامة (10 أرقام)
  nationalId         String?             @unique
  active             Boolean             @default(true)
  departmentId       String?
  department         Department?         @relation("DepartmentMembers", fields: [departmentId], references: [id])
  managerId          String?
  manager            User?               @relation("ReportingLine", fields: [managerId], references: [id])
  reports            User[]              @relation("ReportingLine")
  headOf             Department?         @relation("DepartmentHead")
  requests           Request[]           @relation("RequestSubject")
  createdRequests    Request[]           @relation("RequestCreator")
  approvalSteps      ApprovalStep[]      @relation("StepApprover")
  actedSteps         ApprovalStep[]      @relation("StepActor")
  profile            EmployeeProfile?
  organizedMeetings  Meeting[]           @relation("MeetingOrganizer")
  secretaryMeetings  Meeting[]           @relation("MeetingSecretary")
  meetingInvites     MeetingAttendee[]
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  tickets            Ticket[]            @relation("TicketRequester")
  assignedTickets    Ticket[]            @relation("TicketAssignee")
  comments           Comment[]
  issuedCirculars    Circular[]          @relation("CircularIssuer")
  circularReceipts   CircularRecipient[]
  documents          EmployeeDocument[]
  uploadedFiles      StoredFile[]
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Request {
  id           String         @id @default(cuid())
  number       Int            @unique @default(autoincrement())
  type         RequestType
  subtype      String
  status       RequestStatus  @default(PENDING)
  // الموظف الذي يخصه الطلب (مقدم الإجازة، أو المرسَل إليه التعهد)
  subjectId    String
  subject      User           @relation("RequestSubject", fields: [subjectId], references: [id])
  createdById  String
  createdBy    User           @relation("RequestCreator", fields: [createdById], references: [id])
  startDate    DateTime?      @db.Date
  endDate      DateTime?      @db.Date
  days         Int?
  details      Json           @default("{}")
  notes        String?
  // مرفق الطلب، مثل التقرير الطبي للإجازة المرضية
  attachmentId String?        @unique
  attachment   StoredFile?    @relation("RequestAttachment", fields: [attachmentId], references: [id])
  steps        ApprovalStep[]
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([subjectId])
  @@index([status])
}

model ApprovalStep {
  id         String       @id @default(cuid())
  requestId  String
  request    Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order      Int
  kind       ApproverKind
  // معتمد محدد؛ فارغ يعني أي موظف بصلاحية الموارد البشرية أو الإدارة العليا
  approverId String?
  approver   User?        @relation("StepApprover", fields: [approverId], references: [id])
  status     StepStatus   @default(WAITING)
  comment    String?
  actedById  String?
  actedBy    User?        @relation("StepActor", fields: [actedById], references: [id])
  actedAt    DateTime?

  @@unique([requestId, order])
  @@index([approverId, status])
}

model Setting {
  key   String @id
  value String
}

/**
 * بيانات الموظف التفصيلية التي تديرها الموارد البشرية.
 */
model EmployeeProfile {
  id                  String         @id @default(cuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationality         String?
  birthDate           DateTime?      @db.Date
  gender              Gender?
  maritalStatus       MaritalStatus?
  emergencyName       String?
  emergencyPhone      String?
  hireDate            DateTime?      @db.Date
  contractType        ContractType?
  contractEnd         DateTime?      @db.Date
  probationEnd        DateTime?      @db.Date
  workLocation        String?
  basicSalary         Decimal?       @db.Decimal(12, 2)
  housingAllowance    Decimal?       @db.Decimal(12, 2)
  transportAllowance  Decimal?       @db.Decimal(12, 2)
  otherAllowance      Decimal?       @db.Decimal(12, 2)
  bankName            String?
  iban                String?
  gosiNumber          String?
  // الرصيد الافتتاحي للإجازة السنوية كما في تاريخ معين (عند نقل الموظفين الحاليين للنظام)
  openingLeaveBalance Decimal?       @db.Decimal(6, 2)
  leaveBalanceAsOf    DateTime?      @db.Date
  updatedAt           DateTime       @updatedAt
}

model EmployeeDocument {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       DocumentType
  number     String?
  issueDate  DateTime?    @db.Date
  expiryDate DateTime?    @db.Date
  notes      String?
  fileId     String?      @unique
  file       StoredFile?  @relation("DocumentFile", fields: [fileId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@index([expiryDate])
}

/**
 * ملف مرفوع. المحتوى مخزن في قاعدة البيانات ويُقدّم فقط عبر مسار يتحقق من الصلاحيات.
 */
model StoredFile {
  id           String              @id @default(cuid())
  name         String
  mime         String
  size         Int
  data         Bytes
  uploadedById String
  uploadedBy   User                @relation(fields: [uploadedById], references: [id])
  document     EmployeeDocument?   @relation("DocumentFile")
  request      Request?            @relation("RequestAttachment")
  meeting      MeetingAttachment?
  ticket       Ticket?             @relation("TicketAttachment")
  circular     CircularAttachment?
  createdAt    DateTime            @default(now())
}

model MeetingRoom {
  id       String    @id @default(cuid())
  name     String    @unique
  capacity Int?
  active   Boolean   @default(true)
  meetings Meeting[]
}

model Meeting {
  id                String              @id @default(cuid())
  number            Int                 @unique @default(autoincrement())
  title             String
  startsAt          DateTime
  endsAt            DateTime
  mode              MeetingMode
  roomId            String?
  room              MeetingRoom?        @relation(fields: [roomId], references: [id])
  onlineUrl         String?
  agenda            String?
  organizerId       String
  organizer         User                @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  // أمين السر: يكتب المحضر مع المنظّم
  secretaryId       String?
  secretary         User?               @relation("MeetingSecretary", fields: [secretaryId], references: [id])
  status            MeetingStatus       @default(SCHEDULED)
  minutes           String?
  minutesApprovedAt DateTime?
  attendees         MeetingAttendee[]
  tasks             Task[]
  attachments       MeetingAttachment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([startsAt])
  @@index([roomId, startsAt])
}

model MeetingAttendee {
  meetingId    String
  meeting      Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  response     InviteResponse @default(PENDING)
  responseNote String?
  respondedAt  DateTime?
  // الحضور الفعلي، يُسجل في المحضر
  attended     Boolean?

  @@id([meetingId, userId])
  @@index([userId])
}

model MeetingAttachment {
  id        String     @id @default(cuid())
  meetingId String
  meeting   Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  fileId    String     @unique
  file      StoredFile @relation(fields: [fileId], references: [id])
}

/**
 * مهمة مسندة لموظف: من محضر اجتماع أو أسندها موظف مباشرة.
 */
model Task {
  id          String     @id @default(cuid())
  // فارغ للمهام المسندة مباشرة (ليست من اجتماع)
  meetingId   String?
  meeting     Meeting?   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    Priority   @default(NORMAL)
  assigneeId  String
  assignee    User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id])
  dueDate     DateTime?  @db.Date
  status      TaskStatus @default(NOT_STARTED)
  note        String?
  completedAt DateTime?
  comments    Comment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([assigneeId, status])
  @@map("MeetingTask")
}

/**
 * تذكرة دعم فني لإدارة تقنية المعلومات.
 */
model Ticket {
  id           String         @id @default(cuid())
  number       Int            @unique @default(autoincrement())
  title        String
  description  String
  category     TicketCategory
  priority     Priority       @default(NORMAL)
  status       TicketStatus   @default(NEW)
  requesterId  String
  requester    User           @relation("TicketRequester", fields: [requesterId], references: [id])
  assigneeId   String?
  assignee     User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  attachmentId String?        @unique
  attachment   StoredFile?    @relation("TicketAttachment", fields: [attachmentId], references: [id])
  comments     Comment[]
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([requesterId])
}

/**
 * تعليق على مهمة أو تذكرة.
 */
model Comment {
  id        String   @id @default(cuid())
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // تغيير حالة يُسجل كتعليق نظام
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([ticketId])
}

model Circular {
  id          String               @id @default(cuid())
  // الرقم المعروض: السنة الهجرية / التسلسل، مثل 1448/015
  year        Int
  seq         Int
  title       String
  body        String
  category    CircularCategory
  // التعميم الهام يتطلب إقرار الموظف بالاطلاع والالتزام
  important   Boolean              @default(false)
  audience    CircularAudience
  issuerId    String
  issuer      User                 @relation("CircularIssuer", fields: [issuerId], references: [id])
  expiresAt   DateTime?            @db.Date
  departments CircularDepartment[]
  // نسخة من المستهدفين وقت الإصدار، لمتابعة الاطلاع بدقة
  recipients  CircularRecipient[]
  attachments CircularAttachment[]
  createdAt   DateTime             @default(now())

  @@unique([year, seq])
  @@index([createdAt])
}

model CircularDepartment {
  circularId   String
  circular     Circular   @relation(fields: [circularId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([circularId, departmentId])
}

model CircularRecipient {
  circularId     String
  circular       Circular  @relation(fields: [circularId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  readAt         DateTime?
  acknowledgedAt DateTime?
  remindedAt     DateTime?

  @@id([circularId, userId])
  @@index([userId, readAt])
}

model CircularAttachment {
  id         String     @id @default(cuid())
  circularId String
  circular   Circular   @relation(fields: [circularId], references: [id], onDelete: Cascade)
  fileId     String     @unique
  file       StoredFile @relation(fields: [fileId], references: [id])
}
